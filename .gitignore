# Figma personal access token - never commit
.figma-token

# Env and secrets
.env
.env*
*.local

# Google service account keys - never commit
*service-account*.json
*serviceaccount*.json

# Figma raw cache (16 MB) - keep local
.figma-cache/

# Playwright / MCP output
.playwright-mcp/

# Local working files and backups
scratchpad/

# Python tooling
__pycache__/
*.pyc

# Dependencies and build
node_modules/
/dist/
/build/

# Editor and system
.vscode/
.DS_Store
Thumbs.db

# Claude Code - project rules and local settings stay out of the repo
CLAUDE.md
.claude/settings.local.json

# NOTE: the V1 .gitignore excluded .github/ - deliberately NOT the case here,
# the Actions workflows live there.

# Work instructions - do not belong in the repo
_bootstrap/

# Academy assignment - third-party material, stays local
docs/Join - Issue Collector_Lastenheft.*
