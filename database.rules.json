{
  "rules": {
    "tasks": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$taskId": {
        "status": {
          ".validate": "newData.isString() && newData.val().matches(/^(triage|todo|inprogress|awaitfeedback|done)$/)"
        },
        "prio": {
          ".validate": "newData.isString() && newData.val().matches(/^(urgent|medium|low)$/)"
        },
        "source": {
          ".validate": "newData.isString() && newData.val().matches(/^(manual|email)$/)"
        },
        "aiGenerated": {
          ".validate": "newData.isBoolean()"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        }
      }
    },

    "contacts": {
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['id', 'name', 'email'])",
        "id": {
          ".validate": "newData.val() === $uid"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "email": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "color": {
          ".validate": "newData.isString()"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
