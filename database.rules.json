{
  "rules": {
    ".read": true,

    "tasks": {
      ".write": true,
      "$taskId": {
        "status": {
          ".validate": "newData.isString() && newData.val().matches(/^(triage|todo|inprogress|awaitfeedback|done)$/)"
        },
        "prio": {
          ".validate": "newData.isString() && newData.val().matches(/^(urgent|medium|low)$/)"
        },
        "source": {
          ".validate": "newData.isString() && newData.val().matches(/^(manual|email)$/)"
        },
        "aiGenerated": {
          ".validate": "newData.isBoolean()"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        }
      }
    },

    "contacts": {
      ".write": true
    },

    "users": {
      "$userId": {
        ".write": "!data.exists() || !newData.exists()",
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "email": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "pwHash": {
          ".validate": "newData.isString()"
        },
        "pwSalt": {
          ".validate": "newData.isString()"
        }
      }
    }
  }
}
